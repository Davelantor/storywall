# ---------------------------------------------------------------------------
# File store
# ---------------------------------------------------------------------------
# Where posts are stored, one JSON file per post under pending/ approved/
# live/ rejected/. Defaults to ./data if unset. Point this at a persistent,
# backed-up path on the host - not a directory that gets wiped on redeploy.
DATA_DIR=/var/lib/nordeep-opportunity-wall/data

# ---------------------------------------------------------------------------
# Admin moderation console (/admin)
# ---------------------------------------------------------------------------
# Password for the moderation queue. Use a long random string.
ADMIN_PASSWORD=change-me-to-something-long-and-random
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=change-me-too-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public origin, used for Open Graph URLs and the QR code on the wall.
NEXT_PUBLIC_SITE_URL=https://opportunities.nordeep.com
