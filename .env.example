# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon (publishable) key. Safe to expose to the browser: all
# access is constrained by the row-level security policies in supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used by /admin moderation actions to read pending rows and change status.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Admin moderation console (/admin)
# ---------------------------------------------------------------------------
# Password for the moderation queue. Use a long random string.
ADMIN_PASSWORD=change-me-to-something-long-and-random
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=change-me-too-at-least-32-characters-long

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public origin, used for Open Graph URLs and the QR code on the wall.
NEXT_PUBLIC_SITE_URL=https://opportunities.nordeep.com
